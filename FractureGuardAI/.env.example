# Azure OpenAI (swap with Ollama endpoint for fully local dev)
AZURE_OPENAI_ENDPOINT=https://your-instance.openai.azure.com/
AZURE_OPENAI_API_KEY=your-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Ollama (local LLM, no Azure needed)
OLLAMA_ENDPOINT=http://ollama:11434

# Local dev JWT — hardcoded SiteEngineer claim, generated by Program.cs on startup
DEV_JWT_SECRET=dev-secret-change-in-prod

# RabbitMQ (replaces Azure Service Bus locally)
RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# Cosmos DB Emulator
COSMOS_ENDPOINT=https://cosmos-emulator:8081
COSMOS_KEY=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMzsKvzGW4WZT8ZTg==
COSMOS_DB=FractureGuardDB

# Node.js Notifier
NOTIFIER_URL=http://fractureguard-notifier:3001
NOTIFIER_WEBHOOK_SECRET=local-webhook-secret

# Angular
DOTNET_API_URL=http://localhost:5000
NOTIFIER_WS_URL=http://localhost:3001
