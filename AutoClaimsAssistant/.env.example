# .env.example — copy to .env and fill in for local dev
APP_ENV=local
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=claims_assistant
POSTGRES_USER=claims_assistant
POSTGRES_PASSWORD=devpassword
POSTGRES_SSL_MODE=disable
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_CHAT_DEPLOYMENT=your-gpt-5-mini-deployment-name
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_COVERAGE_DEPLOYMENT=coverage-agent
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=policy-embeddings
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_API_KEY=your-search-admin-key
AZURE_SEARCH_INDEX_NAME=policy-documents
AZURE_STORAGE_CONNECTION_STRING=your-storage-connection-string
AZURE_STORAGE_CONTAINER_NAME=claim-documents
POLICY_DB_MCP_URL=http://localhost:8101/mcp
CLAIMS_HISTORY_MCP_URL=http://localhost:8102/mcp
VIN_VEHICLE_MCP_URL=http://localhost:8103/mcp
AZURE_OPENAI_FRAUD_DEPLOYMENT=fraud-risk-agent
AZURE_OPENAI_ADJUSTER_SUMMARY_DEPLOYMENT=adjuster-summary-agent
AZURE_OPENAI_EVAL_JUDGE_PRIMARY_DEPLOYMENT=eval-judge-primary
AZURE_OPENAI_EVAL_JUDGE_SECONDARY_DEPLOYMENT=eval-judge-secondary




